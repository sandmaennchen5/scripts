# Copy to .env; replace all CHANGE_ME values with: openssl rand -hex 32
STACK_DIR=/volume1/docker/stack_database
TZ=Europe/Berlin
POSTGRES_IMAGE=postgres:18
MARIADB_IMAGE=mariadb:11.8
VALKEY_IMAGE=valkey/valkey:9
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
PAPERLESS_DB_PASSWORD=CHANGE_ME
FORGEJO_DB_PASSWORD=CHANGE_ME
ROMM_DB_PASSWORD=CHANGE_ME
GAME_DB_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME
